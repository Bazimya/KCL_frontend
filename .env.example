# In dev, leave these unset - Vite proxies /api and /uploads to http://localhost:5050
# For a production build VITE_API_URL is REQUIRED (the build fails without it).
# Put it in .env.production or the host's build environment variables:
# VITE_API_URL=https://api.yourdomain.com
# Optional - defaults to VITE_API_URL (uploads are served by the backend):
# VITE_UPLOADS_URL=https://api.yourdomain.com
