# Example nginx site for the built frontend (dist/). The try_files fallback is
# what makes deep links like /t/<qrToken> and /admin/orders work on reload.
server {
    listen 80;
    server_name kigalicoffeelab.com www.kigalicoffeelab.com;
    root /var/www/kcl-frontend/dist;
    index index.html;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
